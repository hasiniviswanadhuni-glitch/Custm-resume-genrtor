# ==========================================
# Customize Resume Generation Platform .env
# ==========================================

# Database Configuration (Supabase PostgreSQL or local SQLite)
# For local SQLite development:
DATABASE_URL=sqlite:///./resume_project.db

# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]

# AI Providers (Optional: system provides deterministic grounded suggestions if omitted)
# NVIDIA NIM (Recommended Free Low-Latency LLM via build.nvidia.com):
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Other Providers (Optional):
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=hybrid

# Security
SECRET_KEY=change-this-in-production-secure-key-32-chars

# Storage for Exports
STORAGE_DIR=./storage/exports
